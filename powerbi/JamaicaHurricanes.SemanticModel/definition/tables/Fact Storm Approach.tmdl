	partition 'Fact Storm Approach' = m
		mode: import
		source =
				let
				    Source = fnGetCsv("storms.csv"),
				    Selected = Table.SelectColumns(Source, {"storm_id", "closest_datetime", "closest_distance_nm", "closest_lat", "closest_lon", "wind_at_closest_kt", "pressure_at_closest_mb", "max_wind_near_kt", "min_pressure_near_mb", "hours_near", "approach_from", "heading_deg", "forward_speed_kt", "max_24h_intensification_kt", "rapid_intensification", "jamaica_landfall", "category_near_jamaica", "is_near", "is_hurricane_near", "is_major_near", "distance_band"}),
				    Blanks = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"storm_id", type text}, {"closest_datetime", type datetime}, {"closest_distance_nm", type number}, {"closest_lat", type number}, {"closest_lon", type number}, {"wind_at_closest_kt", type number}, {"pressure_at_closest_mb", type number}, {"max_wind_near_kt", type number}, {"min_pressure_near_mb", type number}, {"hours_near", Int64.Type}, {"approach_from", type text}, {"heading_deg", Int64.Type}, {"forward_speed_kt", type number}, {"max_24h_intensification_kt", type number}, {"rapid_intensification", type logical}, {"jamaica_landfall", type logical}, {"category_near_jamaica", type text}, {"is_near", type logical}, {"is_hurricane_near", type logical}, {"is_major_near", type logical}, {"distance_band", type text}}, "en-US"),
				    Step0 = Table.AddColumn(Typed, "closest_date", each Date.From([closest_datetime]), type date)
				in
				    Step0

	annotation PBI_ResultType = Table

