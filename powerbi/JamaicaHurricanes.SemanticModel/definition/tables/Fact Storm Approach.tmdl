		lineageTag: 89c05d22-c919-56c1-9f54-934441324475
		summarizeBy: none
		sourceColumn: closest_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Closest approach to the coastline, nautical miles (0 = landfall)
	column closest_distance_nm
