/// One row per storm passage: closest approach, intensity near Jamaica, motion and landfall.
table 'Fact Storm Approach'
	lineageTag: 25ee08ae-71a1-567d-8a8b-163eeeac330f

	column storm_id
		dataType: string
		isHidden
		lineageTag: 58b8e8b5-2c26-5f5c-9913-e304a321fdd1
		summarizeBy: none
		sourceColumn: storm_id

		annotation SummarizationSetBy = User

	column closest_datetime
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: 188a23d3-0f20-5172-8d6e-30e4812fe24d
		summarizeBy: none
		sourceColumn: closest_datetime

		annotation SummarizationSetBy = User

	column closest_date
