/// Calendar 1851 to the end of the current year. Marked as the model's date table.
table 'Dim Date'
	lineageTag: cd89a848-ce95-5e42-aa79-e005fb8d435c
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 9a1d7c99-73c0-5425-af07-a7838a466d60
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: e3ea9d68-53c2-589f-b595-2949a73b923b
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Decade
		dataType: int64
		formatString: 0
		lineageTag: 4b8a6280-e314-595d-b101-40bd966ac8fb
		summarizeBy: none
		sourceColumn: Decade

		annotation SummarizationSetBy = User

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 838f084f-a54f-51bb-b766-1bacf76ba81f
		summarizeBy: none
		sourceColumn: Month Number

		annotation SummarizationSetBy = User

	column Month
		dataType: string
		lineageTag: 14d0dc73-1a6a-5f5b-987a-f186470f8d57
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = User

	column 'Day of Year'
		dataType: int64
		formatString: 0
		lineageTag: 26de190b-ff6c-5107-aae2-d343c7c5a851
		summarizeBy: none
		sourceColumn: Day of Year

		annotation SummarizationSetBy = User

	/// Inside or outside the official Atlantic season (1 Jun - 30 Nov)
	column 'Season Phase'
		dataType: string
		lineageTag: afeb773b-5a10-517a-9f6a-87271acba0ee
		summarizeBy: none
		sourceColumn: Season Phase

		annotation SummarizationSetBy = User

	partition 'Dim Date' = m
		mode: import
		source =
				let
				    StartDate = #date(1851, 1, 1),
				    EndDate = #date(Date.Year(DateTime.LocalNow()), 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
				    AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				    AddDecade = Table.AddColumn(AddYear, "Decade", each Number.IntegerDivide([Year], 10) * 10, Int64.Type),
				    AddMonthNo = Table.AddColumn(AddDecade, "Month Number", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], "MMM", "en-US"), type text),
				    AddDoY = Table.AddColumn(AddMonth, "Day of Year", each Date.DayOfYear([Date]), Int64.Type),
				    AddPhase = Table.AddColumn(AddDoY, "Season Phase", each if [Month Number] >= 6 and [Month Number] <= 11 then "In season" else "Off season", type text)
				in
				    AddPhase

	annotation PBI_ResultType = Table

